<Window x:Class="AsteroidsGC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AsteroidsGC"
        Title="Asteroids-GC" Height="800" Width="1000"
        Background="Black"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=Canvas}">
    <Grid>
        <local:GameCanvas x:Name="Canvas" Focusable="True" ClipToBounds="True" />
    </Grid>
</Window>
